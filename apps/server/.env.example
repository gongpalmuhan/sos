# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Operator fine-grained token: public repositories, read-only (Contents, Issues, Pull requests: Read).
GITHUB_TOKEN=

# OpenAI (확정서 §9). Model ids are configuration; do not silently swap them.
OPENAI_API_KEY=
AI_MODEL_DEFAULT=gpt-6-luna
AI_MODEL_FALLBACK=gpt-6.1-sol
AI_EMBEDDING_MODEL=text-embedding-3-small
# USD per 1M tokens "input,output" — used for cost estimates and the monthly budget guard.
AI_PRICE_DEFAULT=0,0
AI_PRICE_FALLBACK=0,0
AI_PRICE_EMBEDDING=0
AI_MONTHLY_BUDGET_USD=50

# Inngest (cloud: set INNGEST_EVENT_KEY / INNGEST_SIGNING_KEY; local: INNGEST_DEV=1 with `npx inngest-cli dev`)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=

# Client app origin(s) allowed by CORS, and where OAuth callback redirects.
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
